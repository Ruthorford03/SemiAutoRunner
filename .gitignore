auto_test_gui.py
啟動_AutoTest_GUI.bat
escope_config.json
dpo4054_address.cache

# 3. 測試波形截圖、影像與多媒體（包含內部量測波形數據）
*.png
*.jpg
*.jpeg
*.bmp
*.gif
*.mp4
AI實作影片/
ripple_temp*.png

# 4. 本地儀器日誌與快取
*.log
*.cache
*.out
Oscilloscope_Test_set_files/*.log
Oscilloscope_Test_set_files/*.cache
Oscilloscope_Test_set_files/*.bat

# 5. 一次性探索與除錯暫存腳本
add_dynamic_load.py
clean_and_add_dynamic_load.py
explore_config.py
